{
  "engine_key": "V600_ventocr",
  "display_name": "V600",
  "developer": "VentOCR Developer Team",
  "version": "0.2.0",
  "ventocr_min": "0.6.2",
  "engine_api": 3,
  "description": "Draeger Savina 300 / V600 ventilator OCR engine. Breath = display update of VT. Waveforms: Pressure, Flow, Volume (filled curves) with wrap-around sweep tracked frame by frame; y-axis scale read by OCR.",

  "sample_video": "V600_Sample.mp4",
  "base_resolution": "1920x1080",
  "supported_resolutions": ["3840x2160", "1920x1080"],

  "has_extract_waves": true,
  "output_columns": {
    "frames": ["Frame", "VT", "Sweep_X", "BreathMark"],
    "breaths": ["BreathNumber", "VT", "Duration"]
  },

  "breath_summary": ["VT", "VT_displayed"],
  "labels": {
    "VT_displayed": "VT (displayed)"
  },

  "outputs": {
    "waves": [
      { "name": "Pressure", "label": "Paw", "unit": "cmH2O", "color": "#d62728", "scale": { "min": "P_min", "max": "P_max" } },
      { "name": "Flow",     "unit": "L/min", "color": "#1f77b4", "scale": { "min": "F_min", "max": "F_max" } },
      { "name": "Volume",   "unit": "mL",    "color": "#2ca02c", "scale": { "min": "V_min", "max": "V_max" } }
    ],
    "breath_values": [
      { "name": "VT",           "label": "VT",             "unit": "mL" },
      { "name": "VT_displayed", "label": "VT (displayed)", "unit": "mL" }
    ],
    "alerts": [
      { "name": "Fragment", "label": "Cut at the start or end of the recording", "exclude_from_accuracy": true },
      { "name": "Abnormal", "label": "Contains popup or other-screen frames", "exclude_from_accuracy": true },
      { "name": "Long",     "label": "Took more than one sweep; only the last sweep", "exclude_from_accuracy": false },
      { "name": "Partial",  "label": "More than 30% of the waveform missing (screen cleared, etc.)", "exclude_from_accuracy": true },
      { "name": "RT?",      "label": "Biphasic breath: next inspiration before full expiration (e.g. reverse triggering)", "exclude_from_accuracy": false },
      { "name": "Merged?",  "label": "At least 1.7x the neighbouring breaths (possibly two breaths merged)", "exclude_from_accuracy": true }
    ]
  },

  "accuracy": {
    "VT":           { "method": null, "threshold": null, "unit": "mL" },
    "VT_displayed": { "method": null, "threshold": null, "unit": "mL" },
    "BreathMark":   { "method": null, "threshold": null }
  }
}
